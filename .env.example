# ============================================================
# .env.example  –  TUTTI (ognuno aggiunge le proprie variabili)
# ============================================================
# Copiate questo file in ".env" e mettete i valori veri.
# Il file .env NON va mai su GitHub (è già nel .gitignore).
# Questo file invece SI committa, con valori finti/vuoti.
#
# Nota Bun: Bun legge il file .env da solo, non serve il pacchetto dotenv.
# Se usate node/npm invece servirà "dotenv" (import 'dotenv/config').

# --- Server (P1) ---
PORT=3000

# --- Database (P1) ---
# Esempio MongoDB locale o Atlas
MONGO_URI=mongodb://localhost:27017/showtracker

# --- JWT (P1) ---
# Stringa lunga e casuale, NON quella vera qui
JWT_SECRET=cambiami
JWT_EXPIRES_IN=1h

# --- TMDb (P2) ---
# La chiave si ottiene da https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=it-IT
